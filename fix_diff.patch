+    @staticmethod
+    def _detect_platform_from_umo(unified_msg_origin: str) -> str:
+        """浠?unified_msg_origin 瀛楃涓叉娴嬪钩鍙?        
+        鏍煎紡: platform:message_type:session_id
+        渚嬪: "telegram:GroupMessage:-1001234567890" -> "telegram"
+              "qq:GroupMessage:123456789" -> "qq"
+        
+        Args:
+            unified_msg_origin: 鏍囧噯娑堟伅鏉ユ簮瀛楃涓?            
+        Returns:
+            str: 骞冲彴鍚嶇О锛堝皬鍐欙級锛屽 "qq", "telegram", "discord" 绛?        """
+        if unified_msg_origin:
+            parts = unified_msg_origin.split(':')
+            if parts:
+                platform = parts[0].strip().lower()
+                platform_map = {
+                    'qq': 'qq', 'qzone': 'qq', 'guild': 'qq',
+                    'telegram': 'telegram', 'tg': 'telegram',
+                    'discord': 'discord', 'dc': 'discord',
+                    'feishu': 'feishu', 'lark': 'feishu', '椋炰功': 'feishu',
+                    'webchat': 'qq',
+                }
+                return platform_map.get(platform, platform)
+        return 'qq'
