+              "qq:GroupMessage:123456789" -> "qq"
+        
+        Args:
+            event: 娑堟伅浜嬩欢瀵硅薄
+            
+        Returns:
+            str: 骞冲彴鍚嶇О锛堝皬鍐欙級锛屽 "qq", "telegram", "discord" 绛?        """
+        try:
+            unified_msg_origin = getattr(event, 'unified_msg_origin', '') or ''
+            if unified_msg_origin:
+                return MessageStatsPlugin._detect_platform_from_umo(unified_msg_origin)
